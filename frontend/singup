<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Sign Up - AutoTrack</title>
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>
<div class="auth-page">
  <div class="auth-container" style="max-width:520px">
    <div class="auth-logo"><i class="fas fa-car-side" style="color:var(--primary);margin-right:8px"></i>Auto<span>Track</span></div>

    <div class="auth-form">
      <h2>Create Your Account</h2>
      <p>Join AutoTrack and start managing your vehicle maintenance today</p>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Full Name *</label>
          <input class="form-input" id="s-name" placeholder="John Perera" autocomplete="name">
        </div>
        <div class="form-group">
          <label class="form-label">Phone Number *</label>
          <input class="form-input" id="s-phone" placeholder="0771234567" type="tel">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Email Address *</label>
        <input class="form-input" id="s-email" type="email" placeholder="you@gmail.com" autocomplete="email">
      </div>

      <div class="form-group">
        <label class="form-label">Address *</label>
        <input class="form-input" id="s-address" placeholder="123 Main St, Colombo">
      </div>

      <div class="form-group">
        <label class="form-label">Password *</label>
        <div style="position:relative">
          <input class="form-input" id="s-password" type="password" placeholder="Min 8 chars" style="padding-right:44px" autocomplete="new-password">
          <button onclick="togglePwd(this)" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--text-light)"><i class="fas fa-eye"></i></button>
        </div>
        <div class="input-hint"><i class="fas fa-info-circle"></i> Min 8 characters, 1 uppercase letter, 1 special character</div>
      </div>

      <!-- Password strength -->
      <div style="margin-bottom:16px">
        <div style="display:flex;gap:4px;margin-bottom:6px">
          <div class="pwd-bar" id="pwd-bar-1" style="flex:1;height:4px;border-radius:4px;background:var(--border);transition:background 0.3s"></div>
          <div class="pwd-bar" id="pwd-bar-2" style="flex:1;height:4px;border-radius:4px;background:var(--border);transition:background 0.3s"></div>
          <div class="pwd-bar" id="pwd-bar-3" style="flex:1;height:4px;border-radius:4px;background:var(--border);transition:background 0.3s"></div>
          <div class="pwd-bar" id="pwd-bar-4" style="flex:1;height:4px;border-radius:4px;background:var(--border);transition:background 0.3s"></div>
        </div>
        <div id="pwd-strength-label" style="font-size:0.75rem;color:var(--text-light)"></div>
      </div>

      <button class="btn-auth" onclick="signUp()"><i class="fas fa-user-plus"></i> Create Account</button>
      <div class="auth-footer">Already have an account? <a href="login.html">Sign In</a></div>
    </div>

    <div style="text-align:center;margin-top:16px">
      <a href="index.html" style="font-size:0.85rem;color:var(--text-light)"><i class="fas fa-arrow-left"></i> Back to Home</a>
    </div>
  </div>
</div>

<script src="js/api.js"></script>
<script>
  if (isLoggedIn()) window.location.href = 'dashboard.html';

  function togglePwd(btn) {
    const inp = document.getElementById('s-password');
    const show = inp.type === 'password';
    inp.type = show ? 'text' : 'password';
    btn.innerHTML = `<i class="fas fa-eye${show ? '-slash' : ''}"></i>`;
  }

  // Password strength
  document.getElementById('s-password').addEventListener('input', function() {
    const pwd = this.value;
    let score = 0;
    if (pwd.length >= 8) score++;
    if (/[A-Z]/.test(pwd)) score++;
    if (/[^a-zA-Z0-9]/.test(pwd)) score++;
    if (pwd.length >= 12) score++;
    const colors = ['', '#e74c3c', '#f39c12', '#2ecc71', '#27ae60'];
    const labels = ['', 'Weak', 'Fair', 'Good', 'Strong'];
    for (let i = 1; i <= 4; i++) {
      document.getElementById(`pwd-bar-${i}`).style.background = i <= score ? colors[score] : 'var(--border)';
    }
    document.getElementById('pwd-strength-label').textContent = score > 0 ? labels[score] : '';
    document.getElementById('pwd-strength-label').style.color = colors[score] || 'var(--text-light)';
  });

  async function signUp() {
    const name     = document.getElementById('s-name').value.trim();
    const phone    = document.getElementById('s-phone').value.trim();
    const email    = document.getElementById('s-email').value.trim();
    const address  = document.getElementById('s-address').value.trim();
    const password = document.getElementById('s-password').value;

    if (!name || !phone || !email || !address || !password) {
      toast('Please fill in all fields', 'error'); return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      toast('Please enter a valid email', 'error'); return;
    }
    if (password.length < 8) { toast('Password must be at least 8 characters', 'error'); return; }
    if (!/[A-Z]/.test(password)) { toast('Password must contain at least 1 uppercase letter', 'error'); return; }
    if (!/[^a-zA-Z0-9]/.test(password)) { toast('Password must contain at least 1 special character', 'error'); return; }

    try {
      const data = await Auth.signup({ name, phone, email, address, password });
      Auth.saveSession(data);
      toast('Account created! Welcome, ' + data.name + '!');
      setTimeout(() => window.location.href = 'dashboard.html', 900);
    } catch (e) { toast(e.message, 'error'); }
  }

  document.addEventListener('keydown', e => { if (e.key === 'Enter') signUp(); });
</script>
</body>
</html>